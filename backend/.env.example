# Copy to backend/.env and fill in. Never commit the real file.

# --- Database -------------------------------------------------------------
# Unset = local SQLite at backend/data/ra.db.
# Supabase: Dashboard > Connect > Session pooler (IPv4, port 5432). The transaction
# pooler (port 6543) also works; the app then disables its own connection pool.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# All RA tables are created inside this Postgres schema (kept out of Supabase's REST API).
DB_SCHEMA=mf

# --- Copilot ----------------------------------------------------------------
# Provider for new chat sessions: openai | anthropic (existing sessions keep theirs).
COPILOT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5
# ANTHROPIC_API_KEY=sk-ant-...
COPILOT_MODEL=claude-fable-5-1
COPILOT_EFFORT=medium
GUARDRAIL_MODEL=claude-haiku-5-5
COPILOT_REFUSAL_FALLBACKS=true

# Enables /api/admin/* (send it as the X-Admin-Token header); unset = admin API disabled
# ADMIN_TOKEN=

# --- Compliance identity shown in the app ---------------------------------
DISTRIBUTOR_NAME=[DistCo] Pvt Ltd
ARN=ARN-PENDING

# --- Data -----------------------------------------------------------------
NAV_HISTORY_YEARS=6
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Internal tools ---------------------------------------------------------
# internal tool; never enable in production without auth
DATA_EXPLORER_ENABLED=false
# Folder for original AMC files (default backend/data/source_files)
# SOURCE_FILES_DIR=
