# Copy to backend/.env and fill in. Never commit the real file.

# --- Database -------------------------------------------------------------
# Unset = local SQLite at backend/data/ra.db.
# Supabase: Dashboard > Connect > Session pooler (IPv4, port 5432). The transaction
# pooler (port 6543) also works; the app then disables its own connection pool.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# All RA tables are created inside this Postgres schema (kept out of Supabase's REST API).
DB_SCHEMA=mf

# --- Claude (copilot) -----------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
COPILOT_MODEL=claude-fable-5-1
COPILOT_EFFORT=medium
GUARDRAIL_MODEL=claude-haiku-5-5
COPILOT_REFUSAL_FALLBACKS=true

# --- Security ---------------------------------------------------------------
# Fernet key for PAN encryption: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=
# HMAC pepper for PAN lookups (any long random string)
# PAN_HASH_PEPPER=
# Protects /api/admin/* when set
# ADMIN_TOKEN=

# --- Compliance identity shown in the app ---------------------------------
DISTRIBUTOR_NAME=[DistCo] Pvt Ltd
ARN=ARN-PENDING
EUIN=E000000

# --- Data -----------------------------------------------------------------
NAV_HISTORY_YEARS=6
DEFAULT_TAX_SLAB_PCT=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
